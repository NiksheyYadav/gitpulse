# Database (Supabase Postgres connection string — use the pooled "Transaction" URI)
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres"

# Auth.js — generate with: npx auth secret
AUTH_SECRET=""

# GitHub OAuth App (github.com/settings/developers -> New OAuth App)
# Callback URL: http://localhost:3000/api/auth/callback/github (dev)
#               https://yourdomain.com/api/auth/callback/github (prod)
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""

# Razorpay (dashboard.razorpay.com/app/keys)
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
# Webhook secret set when adding the webhook URL in the Razorpay dashboard
RAZORPAY_WEBHOOK_SECRET=""
# Created once via: npx tsx scripts/create-razorpay-plan.ts
RAZORPAY_PLAN_ID_PRO=""
